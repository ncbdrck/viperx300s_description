<?xml version="1.0"?>
<!--
  ViperX-300 S + head-mount Kinect v2. Mount position copied from
  reactorx200_description/urdf/rx200_kinect.urdf.xacro so the visual
  setup is identical across robots — same camera-to-workspace geometry,
  same cube tracker tuning carries over.

  Tweak the <origin> on <xacro:kinect2> if you mount the physical
  kinect somewhere else; the RL envs subscribe to /kinect2/* regardless
  of pose.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vx300s">
    <xacro:include filename="$(find viperx300s_description)/urdf/vx300s.urdf.xacro"/>

    <xacro:include filename="$(find common_sensors)/urdf/sensors/kinect2.urdf.xacro"/>
    <xacro:kinect2 name="kinect2" parent="world">
        <origin rpy="0 0.3 3.15" xyz="1.4 -0.08 0.2"/>
    </xacro:kinect2>
</robot>
